{
  "title": "Haze Messenger - Overview",
  "panels": [
    {
      "title": "Requests per second",
      "type": "graph",
      "targets": [{ "expr": "rate(http_requests_total[1m])", "legendFormat": "{{service}}" }]
    },
    {
      "title": "P95 Latency",
      "type": "graph",
      "targets": [{ "expr": "histogram_quantile(0.95, rate(http_request_duration_seconds_bucket[5m]))", "legendFormat": "{{service}}" }]
    },
    {
      "title": "Active WebSocket connections",
      "type": "stat",
      "targets": [{ "expr": "sum(ws_connections_active)" }]
    },
    {
      "title": "Error rate",
      "type": "graph",
      "targets": [{ "expr": "rate(http_requests_total{status=~\"5..\"}[1m])", "legendFormat": "{{service}}" }]
    }
  ]
}
