FROM golang:1.25-alpine AS builder
WORKDIR /app
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -o /chat ./cmd/chat

FROM alpine:3.19
RUN apk --no-cache add ca-certificates
COPY --from=builder /chat /chat
COPY configs/chat.yaml /configs/chat.yaml
EXPOSE 8082
CMD ["/chat"]